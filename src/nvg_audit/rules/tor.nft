# Reconstructed scenario fixture, NOT the original nOS ruleset.
flush ruleset
table inet audit_filter {
    counter direct_drop {}
    counter dns_drop {}
    chain input { type filter hook input priority 0; policy accept; }
    chain output {
        type filter hook output priority 0; policy drop;
        oifname "lo" accept
        meta skuid 43 accept
        udp dport 53 counter name dns_drop drop
        tcp dport 53 counter name dns_drop drop
        ip daddr 192.168.50.0/24 accept
        ip6 daddr fd00:50::/64 accept
        udp sport 68 udp dport 67 accept
        meta l4proto ipv6-icmp accept
        counter name direct_drop drop
    }
}
table inet audit_nat {
    counter dns_redirect {}
    counter tcp_redirect {}
    chain output {
        type nat hook output priority -100; policy accept;
        oifname "lo" return
        meta skuid 43 return
        udp dport 53 counter name dns_redirect redirect to :9053
        tcp dport 53 counter name tcp_redirect redirect to :9040
        ip daddr 192.168.50.0/24 return
        ip6 daddr fd00:50::/64 return
        meta l4proto tcp redirect to :9040
    }
}
